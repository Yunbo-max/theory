{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autoresearch/native-eval-contract/1.0.0",
  "title": "native-eval-contract",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "benchmark_id",
    "benchmark_revision",
    "split",
    "published_source_refs",
    "native_definition_ref",
    "sample_manifest_ref",
    "labels_or_tests_ref",
    "primary_metric",
    "metrics",
    "prediction_format",
    "sampling",
    "budget",
    "scorer",
    "contrasts",
    "arm_requirements",
    "baseline_qualification",
    "control_qualifications"
  ],
  "properties": {
    "schema_id": {
      "const": "native-eval-contract"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_revision": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "type": "string",
      "minLength": 1
    },
    "published_source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "native_definition_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "sample_manifest_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "labels_or_tests_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "primary_metric": {
      "type": "string",
      "minLength": 1
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "output_path"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "output_path": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "prediction_format": {
      "type": "object",
      "required": [
        "format",
        "records_path",
        "id_path"
      ],
      "properties": {
        "format": {
          "enum": [
            "json",
            "jsonl"
          ]
        },
        "records_path": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          }
        },
        "id_path": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "sampling": {
      "type": "object",
      "required": [
        "policy",
        "parameters"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "minProperties": 1
    },
    "scorer": {
      "type": "object",
      "required": [
        "kind",
        "identity",
        "revision",
        "source_refs",
        "code_refs",
        "command",
        "cwd",
        "output",
        "denominator_path"
      ],
      "properties": {
        "kind": {
          "enum": [
            "official",
            "faithful_harness"
          ]
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "code_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "object",
          "required": [
            "format",
            "source"
          ],
          "properties": {
            "format": {
              "const": "json"
            },
            "source": {
              "enum": [
                "stdout",
                "file"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "denominator_path": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          }
        },
        "verification_ref": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "contrasts": {
      "type": "object",
      "required": [
        "treatment",
        "baseline",
        "controls"
      ],
      "properties": {
        "treatment": {
          "type": "string",
          "minLength": 1
        },
        "baseline": {
          "type": "string",
          "minLength": 1
        },
        "controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "arm_requirements": {
      "type": "object",
      "minProperties": 3
    },
    "baseline_qualification": {
      "type": "object",
      "required": [
        "metric",
        "operator",
        "threshold",
        "reference_ref"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "enum": [
            "ge",
            "gt",
            "le",
            "lt",
            "eq"
          ]
        },
        "threshold": {
          "type": "number"
        },
        "reference_ref": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "control_qualifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "metric",
          "operator",
          "threshold",
          "reference_ref",
          "role"
        ],
        "properties": {
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "operator": {
            "enum": [
              "ge",
              "gt",
              "le",
              "lt",
              "eq"
            ]
          },
          "threshold": {
            "type": "number"
          },
          "reference_ref": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "selection": {
      "type": "object",
      "required": [
        "source_manifest_ref",
        "selected_manifest_ref",
        "rule",
        "seed",
        "count",
        "capability_ref"
      ],
      "properties": {
        "source_manifest_ref": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "selected_manifest_ref": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "rule": {
          "enum": [
            "prefix",
            "sha256_rank"
          ]
        },
        "seed": {
          "type": "integer"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "capability_ref": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
