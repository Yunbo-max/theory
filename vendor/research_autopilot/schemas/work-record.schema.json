{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autoresearch/work-record/1.0.0",
  "title": "work-record",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "work_id",
    "title",
    "authors",
    "primary_source",
    "canonical_url",
    "version",
    "read_depth",
    "full_text_status",
    "claims",
    "evidence_refs"
  ],
  "properties": {
    "schema_id": {
      "const": "work-record"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "work_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "primary_source": {
      "type": "boolean"
    },
    "canonical_url": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "publication_date": {
      "type": "string",
      "minLength": 1
    },
    "read_depth": {
      "enum": [
        "D0",
        "D1",
        "D2",
        "D3"
      ]
    },
    "full_text_status": {
      "enum": [
        "available",
        "inaccessible",
        "unread"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "canonical_work_id": {
      "type": "string",
      "minLength": 1
    },
    "version_id": {
      "type": "string",
      "minLength": 1
    },
    "identity_aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "identity_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from_id",
          "to_id",
          "relation",
          "evidence_refs"
        ],
        "properties": {
          "from_id": {
            "type": "string",
            "minLength": 1
          },
          "to_id": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "const": "same_work"
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "publication_status": {
      "enum": [
        "unknown",
        "preprint",
        "accepted",
        "formally_published",
        "unpublished",
        "withdrawn"
      ]
    },
    "reproduction_status": {
      "enum": [
        "unknown",
        "not_attempted",
        "in_progress",
        "reproduced",
        "failed",
        "partial"
      ]
    }
  },
  "additionalProperties": true
}
